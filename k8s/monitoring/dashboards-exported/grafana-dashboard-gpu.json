{
  "title": "GPU Utilization (DCGM)",
  "uid": "gpu-dcgm",
  "tags": [
    "gpu",
    "dcgm"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "title": "GPU SM Utilization %",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL / 100",
          "legendFormat": "GPU {{gpu}} ({{pod}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "title": "GPU Memory Used (GiB)",
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED / 1024",
          "legendFormat": "GPU {{gpu}} ({{pod}})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "title": "GPU Power Draw (W)",
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "title": "GPU Temperature (\u00b0C)",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    }
  ]
}
