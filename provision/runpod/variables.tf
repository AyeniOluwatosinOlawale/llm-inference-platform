variable "runpod_api_key" {
  description = "RunPod API key — set via TF_VAR_runpod_api_key env var, never in tfvars"
  type        = string
  sensitive   = true
}

variable "huggingface_token" {
  description = "HuggingFace access token for gated model downloads (Llama 3.1)"
  type        = string
  sensitive   = true
}

variable "litellm_master_key" {
  description = "LiteLLM API master key for gateway authentication"
  type        = string
  sensitive   = true
}

variable "redis_password" {
  description = "Redis requirepass value — generated by scripts/generate-secrets.sh"
  type        = string
  sensitive   = true
}

variable "postgres_password" {
  description = "PostgreSQL password for LiteLLM spend DB"
  type        = string
  sensitive   = true
}

variable "grafana_admin_password" {
  description = "Grafana admin UI password"
  type        = string
  sensitive   = true
}

variable "gpu_count" {
  description = "Number of GPU worker nodes in the cluster"
  type        = number
  default     = 2
}

variable "gpu_type" {
  description = "RunPod GPU type — must have >= 24 GB VRAM"
  type        = string
  default     = "NVIDIA RTX A4000"
}

variable "dns_zone" {
  description = "Base DNS zone for ingress hostnames (e.g. example.com → vllm.example.com)"
  type        = string
}

variable "project" {
  description = "Project tag applied to all resources"
  type        = string
  default     = "llm-inference-platform"
}

variable "environment" {
  description = "Deployment environment tag"
  type        = string
  default     = "production"
}
